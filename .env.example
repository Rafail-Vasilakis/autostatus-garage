# AutoStatus Garage OS - Environment Configuration Template
# Copy this file to .env for production deployment or Docker setup

# 1. Flask & Core Security
SECRET_KEY=generate_a_random_secure_secret_key_here_for_production
FLASK_DEBUG=false

# 2. Database Connection
# Leave empty for local SQLite (autostatus.db), or set PostgreSQL URI for Render/Cloud:
# DATABASE_URL=postgresql://user:password@host:5432/autostatus

# 3. Garage White-Label Branding (Customizable per workshop)
GARAGE_NAME=Συνεργείο Αυτοκινήτων - Garage Pro
GARAGE_VAT=094123456
GARAGE_PHONE=210 285 1201
GARAGE_ADDRESS=Λεωφ. Κηφισίας 120, Αθήνα
GARAGE_EMAIL=info@garage.gr

# 4. AADE myDATA & Digital Vehicle Registry (Α.1057/2025)
# Obtain credentials from: https://www.aade.gr/mydata -> Ειδικοί Κωδικοί
AADE_USER_ID=autostatus_workshop
AADE_SUBSCRIPTION_KEY=demo_sandbox_key_aade_2026
AADE_ENV=sandbox # Options: sandbox, production, simulation

# 5. Workshop Terminal PIN (One-time device pairing)
WORKSHOP_PIN=1234

# 6. Initial Seed Data (Set to false for brand new empty workshop)
SEED_DEMO_DATA=true
