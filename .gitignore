# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Secrets
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/

# Private Keys, Certificates & Tokens
*.pem
*.key
*.crt
*.pfx
*.p12
*.token
credentials.json
secrets.json

# Databases (Local SQLite files - never commit local data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Uploaded damage photos (customer private data)
static/uploads/*
!static/uploads/.gitkeep

# Workshop Backup Archives
backups/*
!backups/.gitkeep
*.zip
*.tar.gz

# Logs & Temp files
*.log
logs/
*.tmp
*.bak

# Temporary Test Screenshots
static/img/test_mobile_*.png

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDEs & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
